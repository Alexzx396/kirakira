RewriteEngine On

# Página propia para las direcciones que no existen
ErrorDocument 404 /404.html

# Establecer index.html como la página de inicio predeterminada
DirectoryIndex index.html

# /index y /index.html redirigen a la raíz (www.etherdreams.cl)
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirigir para eliminar la extensión .html si se accede directamente
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Reescribir solo si la solicitud no es por un directorio existente
RewriteCond %{REQUEST_FILENAME} !-d

# Reescribir solo si la solicitud no es por un archivo existente
RewriteCond %{REQUEST_FILENAME} !-f

# Reescribir a ".html" (/information sirve information.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]

# Las páginas se revalidan siempre: así nadie ve una versión vieja guardada en caché
# (CSS y JS ya se versionan con ?v=)
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# El servidor de pruebas local no se publica
RedirectMatch 404 ^/dev(/|$)

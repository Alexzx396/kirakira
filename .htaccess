RewriteEngine On

# Página propia para las direcciones que no existen
ErrorDocument 404 /404.html

# www.etherdreams.cl redirige a etherdreams.cl (un solo sitio para Google)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# Cabeceras de seguridad
<IfModule mod_headers.c>
    # Siempre por HTTPS
    Header always set Strict-Transport-Security "max-age=31536000"
    # El navegador respeta el tipo de archivo que indica el servidor
    Header always set X-Content-Type-Options "nosniff"
    # A otros sitios solo se les informa el dominio de origen, no la página
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Otros sitios no pueden mostrar este dentro de un iframe
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Establecer index.html como la página de inicio predeterminada
DirectoryIndex index.html

# /index y /index.html redirigen a la raíz (www.etherdreams.cl)
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirigir para eliminar la extensión .html si se accede directamente
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Reescribir solo si la solicitud no es por un directorio existente
RewriteCond %{REQUEST_FILENAME} !-d

# Reescribir solo si la solicitud no es por un archivo existente
RewriteCond %{REQUEST_FILENAME} !-f

# Reescribir a ".html" (/information sirve information.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]

# Las páginas se revalidan siempre: así nadie ve una versión vieja guardada en caché
# (CSS y JS ya se versionan con ?v=)
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# El servidor de pruebas local no se publica
RedirectMatch 404 ^/dev(/|$)
